# Copy to `.env` for local dev. `docker compose up` already defaults every value
# below (see docker-compose.yml), so the stack runs with no .env at all — this
# file documents the knobs and is what `make dev` reads when running the app on
# the host against the compose Postgres + MinIO. Placeholders only, never secrets.

# --- Database ---
POSTGRES_USER=cicero
POSTGRES_PASSWORD=cicero
POSTGRES_DB=cicero
# Host-side URL (running the app with `make dev`); compose overrides the host
# with `db` for the api container.
DATABASE_URL=postgresql+asyncpg://cicero:cicero@localhost:5432/cicero

# --- Object storage (S3-compatible: MinIO locally, any S3 in the cloud) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=cicero
S3_SECRET_ACCESS_KEY=cicero-secret
S3_BUCKET=documents
S3_REGION=us-east-1

# --- Summarization LLM (optional) ---
# Unset → the built-in mock summarizer (zero-config; `docker compose up` needs no
# key). Set LLM_BASE_URL to any OpenAI-compatible endpoint — include the /v1 — to
# summarise with a real model.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...        # omit for local endpoints that need no key (e.g. Ollama)
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=60           # seconds; raise it for a slow local model (e.g. 300)
# LLM_SUMMARIZE_MAX_INPUT_CHARS=100000   # input above this is map-reduced; shrink for a smaller context
# A host-run LLM is not at `localhost` from inside the api container — use
# `host.docker.internal` (compose maps it): LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- Admin SPA (compose `web` service) ---
# Host port for the nginx-served admin SPA; it proxies /api to the api container.
WEB_HOST_PORT=5173
